---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import AboutVision from '../components/sections/AboutVision.astro';
import AboutYears from '../components/sections/AboutYears.astro';
import AboutBeliefs from '../components/sections/AboutBeliefs.astro';
import Faq from '../components/sections/Faq.astro';
import Team from '../components/sections/Team.astro';
import { site } from '../lib/site';
const about = await site('about');
---
<Base
  title="About Nanak Fabricator — Our Story & Vehicle fabrication and Repair Expertise"
  description="Nanak Fabricators Ltd. was founded in 2012 at Khim Business Park, Athi River. Meet the team behind our truck body fabrication, panel beating and accident repair work."
>
  <PageHeader label={about.header.label} title={about.header.title} />
  <AboutVision />
  <AboutYears />
  <AboutBeliefs />
  <Faq />
  <Team />
</Base>
