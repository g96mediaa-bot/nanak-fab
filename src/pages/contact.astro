---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Offices from '../components/sections/Offices.astro';
import Faq from '../components/sections/Faq.astro';
import { site } from '../lib/site';
const contact = await site('contact');
---
<Base
  title="Contact Nanak Fabricators — Get in Touch"
  description="Get a quote for a truck body, tanker, trailer or accident repair. Call 0703 450 080 or visit our workshop at Khim Business Park, Athi River."
>
  <PageHeader label={contact.header.label} title={contact.header.title} />
  <Offices />
  <Faq />
</Base>
