---
import Btn from '../Btn.astro';
import BeforeAfterSlider from '../BeforeAfterSlider.astro';
import { site } from '../../lib/site';
const services = await site('services');
const r = services.repair;
---
<section class="rep" data-dark>
  <div class="container rep__inner">
    <div class="rep__head">
      <div class="rep__title">
        <p class="t-caption2 c-200" data-appear>{r.label}</p>
        <h2 class="t-h2 c-50" data-appear style="--appear-delay:0.1s">Accident repair, <span class="h-accent">without the guesswork</span></h2>
      </div>
      <div class="rep__side">
        <p class="t-body-sm c-200" data-appear style="--appear-delay:0.2s">{r.text}</p>
        <div data-appear style="--appear-delay:0.3s"><Btn label={r.cta.label} href={r.cta.href} variant="secondary" /></div>
      </div>
    </div>
    <div class="rep__body">
      <div class="rep__media" data-appear style="--appear-delay:0.2s">
        <BeforeAfterSlider
          beforeImage="/assets/site/accident/accident-before.webp"
          afterImage="/assets/site/accident/accident-after.webp"
          alt="Isuzu FRR cab repaired at Nanak Fabricators"
          caption="Drag or use the arrow keys to reveal the repair."
        />
      </div>
      <ul class="rep__list" data-appear style="--appear-delay:0.3s">
        {r.items.map((item: string) => (
          <li class="t-body c-50">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .rep { position: relative; padding-block: 80px; background: var(--ink-950); overflow: clip; }
  .rep__inner { display: flex; flex-direction: column; gap: 40px; }
  .rep__head { display: flex; align-items: flex-end; gap: 20px; }
  .rep__title { flex: 1 1 0; display: flex; flex-direction: column; gap: 12px; }
  .rep__title h2 { max-width: 520px; }
  .rep__side { flex: 1 1 0; max-width: 460px; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .rep__body { display: flex; align-items: flex-start; gap: 40px; }
  .rep__media { flex: 1 1 0; min-width: 0; }
  .rep__media :global(figcaption) { color: var(--ink-300); }
  .rep__list { width: 300px; flex: none; display: flex; flex-direction: column; gap: 12px; }
  .rep__list li { padding-bottom: 12px; box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.2); }
  @media (max-width: 1199.98px) {
    .rep { padding-block: 40px; }
    .rep__body { align-items: stretch; }
  }
  @media (max-width: 809.98px) {
    .rep__head, .rep__body { flex-direction: column; }
    .rep__side { max-width: none; }
    .rep__list { width: 100%; }
  }
</style>
