---
// Brochure wordmark: NF monogram (N blue, F red) beside a black serif "NANAK"
// and a red "FABRICATORS LIMITED". `light` flips the lettering for dark panels.
interface Props {
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  linked?: boolean;
}
const { variant = 'dark', size = 'md', linked = true } = Astro.props;
const Tag = linked ? 'a' : 'div';
---
<Tag
  class:list={['logo', `logo--${variant}`, `logo--${size}`]}
  href={linked ? '/' : undefined}
  aria-label={linked ? 'Nanak Fabricators Limited — home' : undefined}
>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <g class="logo__n">
      <rect x="2" y="6" width="5" height="36"></rect>
      <polygon points="7,6 13,6 23,42 17,42"></polygon>
      <rect x="19" y="6" width="5" height="36"></rect>
    </g>
    <g class="logo__f">
      <rect x="29" y="6" width="5" height="36"></rect>
      <rect x="29" y="6" width="16" height="5"></rect>
      <rect x="29" y="20" width="13" height="5"></rect>
    </g>
  </svg>
  <span class="logo__text">
    <span class="logo__name">NANAK</span>
    <span class="logo__sub">FABRICATORS LIMITED</span>
  </span>
</Tag>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.45em; line-height: 1; }
  .logo__mark { width: 1.6em; height: 1.6em; flex: none; }
  .logo__n { fill: var(--logo-blue); }
  .logo__f { fill: var(--accent); }
  .logo__text { display: inline-flex; flex-direction: column; gap: 0.18em; }
  .logo__name {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: 1.15em;
    letter-spacing: 0.01em;
    color: var(--ink-900);
  }
  .logo__sub {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.33em;
    letter-spacing: 0.18em;
    color: var(--accent);
    white-space: nowrap;
  }
  .logo--light .logo__name { color: var(--white); }
  .logo--light .logo__sub { color: var(--peach); }
  .logo--light .logo__n { fill: var(--white); }

  .logo--sm { font-size: 16px; }
  .logo--md { font-size: 24px; }
  .logo--lg { font-size: 34px; }
  @media (max-width: 809.98px) { .logo--lg { font-size: 26px; } }
</style>
